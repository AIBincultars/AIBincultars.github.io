---
import ResearchProjectLayout from '../../../layouts/ResearchProjectLayout.astro';
import CaseGroup from '../../../components/uot-ir/CaseGroup.astro';
import ImagePreview from '../../../components/uot-ir/ImagePreview.astro';
import MetricTable from '../../../components/uot-ir/MetricTable.astro';
import PianoRoll from '../../../components/uot-ir/PianoRoll.astro';
import { demoAssets, demoCases, listeningCases, listeningManifestUrl } from '../../../data/uot-ir';

const description = 'UOT-IR routes multitrack symbolic music into fixed-budget representations. Explore audio previews, MIDI examples, piano rolls, and per-example metrics.';
const downloadCases = [...listeningCases, ...demoCases];
const trackCount = downloadCases.reduce((count, demoCase) => count + demoCase.tracks.length, 0);
const audioCount = listeningCases.reduce((count, demoCase) => count + demoCase.tracks.length, 0);
const metricCount = demoAssets.filter((asset) => asset.type === 'metric').length;
const exampleLabel = (index: number) => `Example ${String(index + 1).padStart(2, '0')}`;
const clockLabel = (seconds: number) => `${String(Math.floor(seconds / 60)).padStart(2, '0')}:${(seconds % 60).toFixed(1).padStart(4, '0')}`;
const citation = `@misc{kang2026uotir,
  title = {{UOT-IR}: Structured Routing of High-Polyphony Symbolic Music into Fixed-Budget Representations},
  author = {Ziyue Kang and Nan Nan and Chenhao Lin and Xiaohong Guan},
  year = {2026},
  eprint = {2608.00576},
  archivePrefix = {arXiv},
  primaryClass = {cs.SD},
  url = {https://arxiv.org/abs/2608.00576},
  note = {Accepted at ISMIR 2026}
}`;
---

<ResearchProjectLayout title="UOT-IR | Ziyue Kang" description={description}>
  <div class="research-project">
    <header class="project-hero">
      <p class="project-eyebrow"><a href="/en/projects/">Research projects</a><span aria-hidden="true">/</span>ISMIR 2026</p>
      <h1>UOT-IR</h1>
      <p class="project-title">Structured routing for fixed-budget symbolic music.</p>
      <p class="project-description">Route multitrack MIDI into a fixed instrument budget with bar-level optimal transport.</p>
      <p class="project-authors">Ziyue Kang · Nan Nan · Chenhao Lin · Xiaohong Guan</p>
      <div class="text-links project-actions">
        <a href="https://arxiv.org/abs/2608.00576">Read the paper <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/AIBincultars/UOT-IR">View code <span aria-hidden="true">↗</span></a>
      </div>
      <p class="project-facts">{listeningCases.length} listening pairs <span aria-hidden="true">·</span> {demoCases.length} comparison cases <span aria-hidden="true">·</span> 16 slots by default</p>
    </header>

    <nav class="project-navigation" aria-label="On this page">
      <a href="#listening">Listen</a>
      <a href="#visual-results">Examples</a>
      <a href="#metrics">Results</a>
      <a href="#midi-examples">Downloads</a>
      <a href="#paper">Citation</a>
    </nav>

    <section id="listening" class="project-section">
      <div class="section-heading"><h2>Listening selections</h2><span>Around 30 seconds per pair</span></div>
      <p class="section-description">Selected passages with close note and instrument preservation. Each pair uses the same passage, instrument SoundFont, and playback gain.</p>
      {listeningCases.map((entry, index) => (
        <CaseGroup summary={`${String(index + 1).padStart(2, '0')} · ${entry.title}`} meta={`${entry.durationSeconds.toFixed(1)} s`} open={index === 0}>
          <p class="listening-context">Bars {entry.startBar}–{entry.endBar} · {clockLabel(entry.startSeconds)}–{clockLabel(entry.endSeconds)} in the full MIDI · {entry.input.excerptInstrumentParts} → {entry.output.excerptInstrumentParts} instrument parts in this excerpt</p>
          <div class="featured-gallery">
            <PianoRoll caseId={entry.id} track={entry.input} />
            <PianoRoll caseId={entry.id} track={entry.output} />
          </div>
          <p class="listening-source">SymphonyNet · {entry.sampleId.split('/').pop()} · Template standardization · <a href={entry.output.metricsUrl} download>Full-piece metrics</a></p>
        </CaseGroup>
      ))}
      <CaseGroup summary="About these selections">
        <p class="listening-context">Selection prioritizes retained notes, instrument continuity, and moderate density. These are curated examples from existing outputs. The full MIDI downloads preserve the original input and output files.</p>
        <p class="listening-context">Both versions use FluidSynth with FluidR3 GM, a shared gain within each pair, and a short fade at the excerpt boundaries. Instrument parts are counted across each excerpt. Full-piece metric files describe the complete MIDI.</p>
        <a class="listening-protocol" href={listeningManifestUrl} download>Selection and rendering details ↓</a>
      </CaseGroup>
    </section>

    <section id="visual-results" class="project-section">
      <div class="section-heading"><h2>Examples</h2><span>Template standardization</span></div>
      <p class="section-description">Explore six additional cases across all eleven methods. Select a piano roll for a closer look, and download each complete MIDI for comparison.</p>
      <div class="example-list">
        {demoCases.map((demoCase, index) => (
          <CaseGroup summary={exampleLabel(index)} meta="Input & UOT-IR">
            <div class="featured-gallery">
              <PianoRoll caseId={demoCase.id} track={demoCase.input} />
              <PianoRoll caseId={demoCase.id} track={demoCase.outputs[0]} />
            </div>
            <CaseGroup summary="Compare other methods" meta={`${demoCase.outputs.length - 1} methods`} variant="comparison">
              <div class="gallery">
                {demoCase.outputs.slice(1).map((track) => <PianoRoll caseId={demoCase.id} track={track} />)}
              </div>
            </CaseGroup>
          </CaseGroup>
        ))}
      </div>
    </section>

    <section id="metrics" class="project-section">
      <div class="section-heading"><h2>Results</h2><a href="https://github.com/AIBincultars/UOT-IR/blob/main/docs/EXPERIMENTS.md">Metric definitions <span aria-hidden="true">↗</span></a></div>
      <p class="section-description">Per-example metrics for the MIDI files shown above. Arrows indicate the preferred direction.</p>
      {demoCases.map((demoCase, index) => (
        <CaseGroup summary={exampleLabel(index)} meta={`${demoCase.outputs.length} methods`} open={index === 0}>
          <MetricTable caseId={demoCase.id} tracks={demoCase.outputs} />
        </CaseGroup>
      ))}
    </section>

    <section id="midi-examples" class="project-section">
      <div class="section-heading"><h2>Downloads</h2><span>{trackCount} MIDI · {audioCount} MP3 · {metricCount} metrics</span></div>
      <p class="section-description">Each piano roll includes a MIDI download, with MP3 downloads alongside audio previews. Browse all files by example below.</p>
      <div id="downloads">
        <CaseGroup summary="Audio previews (MP3)" meta={`${audioCount} files`}>
          {listeningCases.map((demoCase) => (
            <CaseGroup summary={demoCase.title}>
              <div class="resource-list audio-downloads">
                {demoCase.tracks.filter((track) => track.audioUrl).map((track) => <a href={track.audioUrl} download>{track.label} <span aria-hidden="true">↓</span></a>)}
              </div>
            </CaseGroup>
          ))}
        </CaseGroup>
        <CaseGroup summary="MIDI files" meta={`${trackCount} files`}>
          {downloadCases.map((demoCase, index) => (
            <CaseGroup summary={'title' in demoCase ? demoCase.title : exampleLabel(index - listeningCases.length)}>
              <div class="resource-list midi-downloads">
                {demoCase.tracks.map((track) => <a href={track.midiUrl} download>{track.label} <span aria-hidden="true">↓</span></a>)}
              </div>
            </CaseGroup>
          ))}
        </CaseGroup>
        <CaseGroup summary="Metric JSON files" meta={`${metricCount} files`}>
          {listeningCases.map((entry) => (
            <CaseGroup summary={entry.title}>
              <div class="resource-list metric-downloads"><a href={entry.output.metricsUrl} download>UOT-IR · complete MIDI <span aria-hidden="true">↓</span></a></div>
            </CaseGroup>
          ))}
          {demoCases.map((demoCase, index) => (
            <CaseGroup summary={exampleLabel(index)}>
              <div class="resource-list metric-downloads">
                {demoCase.outputs.map((track) => <a href={track.metricsUrl} download>{track.label} <span aria-hidden="true">↓</span></a>)}
              </div>
            </CaseGroup>
          ))}
        </CaseGroup>
        <CaseGroup summary="Complete asset index" meta={`${demoAssets.length} files`}>
          <div class="table-scroll" role="region" aria-label="Complete asset index" tabindex="0">
            <table class="compact-table asset-index">
              <thead><tr><th scope="col">File</th><th scope="col">Type</th><th scope="col">Description</th></tr></thead>
              <tbody>
                {demoAssets.map((asset) => (
                  <tr><td><a href={asset.url} download>{asset.filename}</a></td><td>{asset.type}</td><td>{asset.description}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </CaseGroup>
      </div>
    </section>

    <section id="paper" class="project-section paper-section">
      <div class="section-heading"><h2>Paper & citation</h2><span>ISMIR 2026</span></div>
      <p class="paper-reference">
        Ziyue Kang, Nan Nan, Chenhao Lin, and Xiaohong Guan.<br />
        <a href="https://arxiv.org/abs/2608.00576">UOT-IR: Structured Routing of High-Polyphony Symbolic Music into Fixed-Budget Representations.</a>
      </p>
      <CaseGroup summary="BibTeX">
        <pre class="citation"><code>{citation}</code></pre>
      </CaseGroup>
      <CaseGroup summary="Affiliations & correspondence">
        <div class="paper-details">
          <p>Ziyue Kang¹˒² · Nan Nan*¹˒²˒³ · Chenhao Lin¹˒²˒³ · Xiaohong Guan¹˒²˒³˒⁴</p>
          <ol>
            <li>Frontier Institute of Science and Technology, Xi'an Jiaotong University, Xi'an, China</li>
            <li>Interdisciplinary Research Center of Frontier Science and Technology, Xi'an Jiaotong University, Xi'an, China</li>
            <li>MOE KLINNS Lab, Faculty of Electronic and Information Engineering, Xi'an Jiaotong University, Xi'an, China</li>
            <li>Center for Intelligent and Networked Systems, Tsinghua University, Beijing, China</li>
          </ol>
          <p>* Corresponding author: Nan Nan · <a href="mailto:nan.nan@xjtu.edu.cn">nan.nan@xjtu.edu.cn</a></p>
        </div>
      </CaseGroup>
    </section>
  </div>
  <ImagePreview />
</ResearchProjectLayout>

<style is:global>
  .research-project { max-width: 900px; }
  .project-hero { max-width: 820px; padding: 60px 0 36px; }
  .project-eyebrow { display: flex; gap: 12px; margin-bottom: 22px; color: var(--text-tertiary); font-size: 12px; }
  .project-eyebrow a { color: var(--text-secondary); }
  .project-hero h1 { margin: 0 0 14px; font-size: clamp(44px, 6vw, 62px); font-weight: 600; letter-spacing: -0.045em; line-height: 1; }
  .project-title { max-width: 780px; margin-bottom: 16px; font-size: clamp(19px, 2.4vw, 24px); font-weight: 500; letter-spacing: -0.02em; line-height: 1.48; text-wrap: balance; }
  .project-description { max-width: 730px; margin-bottom: 18px; color: var(--text-secondary); font-size: 14px; }
  .project-authors { margin-bottom: 0; color: var(--text-secondary); font-size: 12px; }
  .project-actions { gap: 24px; margin-top: 18px; }
  .project-facts { margin: 26px 0 0; color: var(--text-tertiary); font-size: 12px; }
  .project-facts span { padding-inline: 9px; }
  .project-navigation {
    position: sticky;
    top: 70px;
    z-index: 20;
    display: flex;
    overflow-x: auto;
    white-space: nowrap;
    gap: 28px;
    padding: 15px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    font-size: 12px;
    font-weight: 500;
  }
  .project-navigation a { color: var(--text-secondary); }
  .project-navigation a:hover { color: var(--accent); }
  .project-section { padding-top: 46px; scroll-margin-top: 145px; }
  #downloads { scroll-margin-top: 145px; }
  .section-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 18px; margin-bottom: 9px; }
  .section-heading h2 { margin: 0; font-size: 20px; font-weight: 600; letter-spacing: -0.025em; }
  .section-heading > span, .section-heading > a { color: var(--text-tertiary); font-size: 11px; }
  .section-heading > a:hover { color: var(--accent); }
  .section-description { margin-bottom: 22px; color: var(--text-secondary); font-size: 13px; }
  .listening-context { margin: 0 0 16px; color: var(--text-secondary); font-size: 12px; line-height: 1.8; }
  .listening-source { margin: 12px 0 0; color: var(--text-tertiary); font-size: 11px; }
  .listening-protocol { font-size: 12px; }
  .research-project .case-group { border-top: 1px solid var(--line); }
  .research-project .case-group:last-child { border-bottom: 1px solid var(--line); }
  .research-project .case-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-height: 58px;
    padding: 16px 0;
    list-style: none;
    cursor: pointer;
    font-size: 13px;
    font-weight: 500;
  }
  .case-summary-end { display: flex; align-items: center; gap: 22px; }
  .case-meta { color: var(--text-tertiary); font-size: 11px; font-weight: 400; }
  .research-project .case-content { padding-bottom: 22px; }
  .featured-gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .research-project .method-comparison { margin-top: 16px; border: 0; }
  .research-project .method-comparison:last-child { border: 0; }
  .research-project .method-comparison > .case-summary { min-height: 40px; padding: 8px 0; color: var(--text-secondary); font-size: 12px; }
  .research-project .method-comparison > .case-content { padding-top: 8px; padding-bottom: 0; }
  .table-scroll { max-width: 100%; overflow-x: auto; }
  .table-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .compact-table { width: 100%; border-collapse: collapse; font-size: 11px; font-variant-numeric: tabular-nums; }
  .compact-table th, .compact-table td { padding: 11px 9px; border-bottom: 1px solid var(--line); text-align: right; white-space: nowrap; }
  .compact-table th { color: var(--text-secondary); font-size: 10px; font-weight: 500; }
  .compact-table th:first-child, .compact-table td:first-child { padding-left: 12px; text-align: left; }
  .main-method-row { background: color-mix(in srgb, var(--accent) 4%, var(--surface)); font-weight: 600; }
  .main-method-row td:first-child { color: var(--accent); }
  .resource-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px 24px; padding: 4px 0 8px; font-size: 12px; }
  .resource-list a { display: flex; justify-content: space-between; gap: 12px; }
  #downloads .case-content .case-group { padding-inline: 16px; }
  .asset-index th, .asset-index td { text-align: left; }
  .paper-reference { margin: 20px 0 25px; color: var(--text-secondary); font-size: 13px; line-height: 1.8; }
  .paper-reference a { color: var(--text); }
  .paper-reference a:hover { color: var(--accent); }
  .citation { max-width: 100%; margin: 0; padding: 18px; border: 1px solid var(--line); border-radius: 4px; overflow-x: auto; background: var(--surface); font-size: 11px; line-height: 1.8; }
  .paper-details { max-width: 780px; color: var(--text-secondary); font-size: 12px; }
  .paper-details p { margin-bottom: 14px; }
  .paper-details ol { padding-left: 18px; margin-bottom: 18px; }
  .paper-details li { padding: 3px 0; }
  .img-error { margin-top: 8px; color: var(--text-secondary); font-size: 12px; }

  @media (max-width: 640px) {
    .project-hero { padding-top: 42px; padding-bottom: 28px; }
    .project-eyebrow { margin-bottom: 20px; }
    .project-hero h1 { font-size: 44px; }
    .project-title { font-size: 20px; }
    .project-description { font-size: 13px; }
    .project-authors { max-width: 310px; line-height: 1.8; }
    .project-facts span { padding-inline: 5px; }
    .project-navigation { top: 64px; gap: 16px; font-size: 11px; }
    .project-section { padding-top: 34px; scroll-margin-top: 130px; }
    #downloads { scroll-margin-top: 130px; }
    .section-heading { flex-wrap: wrap; gap: 4px 16px; }
    .section-description { margin-bottom: 18px; }
    .featured-gallery, .gallery { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .case-summary-end { gap: 14px; }
    .case-meta { font-size: 10px; }
    .resource-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 18px; }
    .compact-table th, .compact-table td { padding: 10px 9px; }
    .citation { padding: 14px; }
  }
</style>
