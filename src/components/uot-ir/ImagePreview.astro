<dialog id="lightbox" aria-labelledby="lightboxCaption">
  <div class="lightbox-panel">
    <button id="lightboxClose" class="lightbox-close" type="button" aria-label="Close image preview">&times;</button>
    <img id="lightboxImage" class="lightbox-image" alt="" />
    <p id="lightboxCaption" class="lightbox-caption"></p>
  </div>
</dialog>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>('#lightbox');
  const image = document.querySelector<HTMLImageElement>('#lightboxImage');
  const caption = document.querySelector<HTMLElement>('#lightboxCaption');
  const closeButton = document.querySelector<HTMLButtonElement>('#lightboxClose');

  if (lightbox && image && caption && closeButton) {
    document.querySelectorAll<HTMLButtonElement>('[data-piano-roll-preview]').forEach((button) => {
      button.addEventListener('click', () => {
        const thumbnail = button.querySelector('img');
        if (!thumbnail) return;
        image.src = thumbnail.src;
        image.alt = thumbnail.alt;
        caption.textContent = button.dataset.caption ?? thumbnail.alt;
        lightbox.showModal();
      });
    });

    closeButton.addEventListener('click', () => lightbox.close());
    lightbox.addEventListener('click', (event) => {
      if (event.target !== lightbox) return;
      const bounds = lightbox.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) {
        lightbox.close();
      }
    });
    lightbox.addEventListener('close', () => {
      image.removeAttribute('src');
      image.alt = '';
      caption.textContent = '';
    });
  }

  document.querySelectorAll<HTMLImageElement>('img.zoomable').forEach((thumbnail) => {
    const showError = () => {
      const button = thumbnail.parentElement;
      if (!(button instanceof HTMLButtonElement) || button.disabled) return;
      button.disabled = true;
      const message = document.createElement('div');
      message.className = 'img-error';
      message.textContent = 'Image failed to load.';
      button.after(message);
    };
    thumbnail.addEventListener('error', showError);
    if (thumbnail.complete && thumbnail.naturalWidth === 0) showError();
  });
</script>

<style>
  dialog {
    max-width: 95vw;
    max-height: 90vh;
    padding: 0;
    border: 0;
    overflow: visible;
    background: transparent;
    color: #f3f4f6;
  }

  dialog::backdrop {
    background: rgba(0, 0, 0, 0.72);
  }

  .lightbox-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .lightbox-image {
    display: block;
    max-width: 95vw;
    max-height: 80vh;
    width: auto;
    height: auto;
    border-radius: 6px;
    object-fit: contain;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
    background: #111;
  }

  .lightbox-caption {
    max-width: 92vw;
    margin: 10px 0 0;
    font-size: 13px;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .lightbox-close {
    position: absolute;
    right: 0;
    top: -40px;
    width: 32px;
    height: 32px;
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: 6px;
    background: rgba(0, 0, 0, 0.4);
    color: #fff;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox-close:hover,
  .lightbox-close:focus-visible {
    background: rgba(0, 0, 0, 0.6);
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
</style>
