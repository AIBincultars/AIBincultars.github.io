---
import type { DemoTrack } from '../../data/uot-ir';

interface Props {
  caseId: string;
  track: DemoTrack;
}

const { caseId, track } = Astro.props;
const caption = `${caseId} / ${track.label}`;
---

<figure class:list={['demo-figure', { 'is-uotir': track.method === 'UOTIR' }]}>
  <button
    class="piano-roll-preview"
    type="button"
    aria-label={`Preview ${caption}`}
    data-piano-roll-preview
    data-caption={caption}
  >
    <img class="zoomable" src={track.imageUrl} alt={caption} width="2520" height="648" loading="lazy" />
  </button>
  <figcaption>
    <div class="figure-heading">
      <div>
        <strong>{track.label}</strong>
        <span class="figure-description">{track.isExcerpt ? 'Listening excerpt' : track.method === 'Input' ? 'Original score' : 'Reduced score'}</span>
      </div>
      <div class="figure-downloads">
        {track.audioUrl && <a class="figure-download" href={track.audioUrl} download aria-label={`Download ${caption} audio`}>MP3 <span aria-hidden="true">↓</span></a>}
        <a class="figure-download" href={track.midiUrl} download aria-label={`Download ${caption} full MIDI`}>{track.isExcerpt ? 'Full MIDI' : 'MIDI'} <span aria-hidden="true">↓</span></a>
      </div>
    </div>
    {track.audioUrl && (
      <audio class="audio-preview" controls preload="none" src={track.audioUrl} aria-label={`Listen to ${caption}`} data-uotir-audio>
        <a href={track.audioUrl}>Download the audio preview as MP3.</a>
      </audio>
    )}
  </figcaption>
</figure>

<script>
  const previews = document.querySelectorAll<HTMLAudioElement>('audio[data-uotir-audio]');
  previews.forEach((preview) => {
    preview.addEventListener('play', () => {
      previews.forEach((other) => {
        if (other !== preview) other.pause();
      });
    });
  });
</script>

<style>
  .demo-figure {
    min-width: 0;
    margin: 0;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
  }

  .piano-roll-preview {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 3px;
    background: transparent;
    cursor: zoom-in;
  }

  .piano-roll-preview:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
    transition: opacity 150ms ease;
  }

  .piano-roll-preview:hover img { opacity: 0.85; }

  figcaption {
    padding: 12px 2px 2px;
    font-size: 12px;
  }

  .figure-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .figure-downloads { display: flex; flex: none; gap: 12px; }
  .audio-preview { display: block; width: 100%; min-width: 0; height: 36px; margin-top: 12px; }

  strong { font-weight: 600; }
  .is-uotir strong { color: var(--accent); }
  .figure-description { display: block; margin-top: 2px; color: var(--text-tertiary); font-size: 11px; }
  .figure-download { flex: none; font-size: 11px; font-weight: 500; }
</style>
