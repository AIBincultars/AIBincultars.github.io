---
interface Props {
  title: string;
  open?: boolean;
  class?: string;
}

const { title, open = false, class: className } = Astro.props;
---

<details class:list={['accordion-section', className]} open={open} data-accordion>
  <summary aria-expanded={open}>
    <span>{title}</span>
    <span class="summary-mark" aria-hidden="true"></span>
  </summary>
  <div class="accordion-content"><slot /></div>
</details>
