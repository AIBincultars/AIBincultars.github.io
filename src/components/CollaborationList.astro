---
import type { CollectionEntry } from 'astro:content';
import { localize, type Language } from '../config/site';

interface Props {
  collaborations: CollectionEntry<'collaborations'>[];
  language: Language;
}

const { collaborations, language } = Astro.props;
---

<ul class="collaboration-list">
  {collaborations.map(({ data: collaboration }) => (
    <li>
      <a href={localize(collaboration.officialUrl, language)} target="_blank" rel="noopener noreferrer">
        {localize(collaboration.title, language)} <span aria-hidden="true">↗</span>
      </a>
    </li>
  ))}
</ul>
